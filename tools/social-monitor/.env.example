# Reddit API Credentials (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=TaxDropMonitor/1.0

# X/Twitter API Credentials (https://developer.twitter.com/)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_token_secret
TWITTER_BEARER_TOKEN=your_bearer_token

# OpenAI API Key for response generation (optional - can use Anthropic instead)
OPENAI_API_KEY=your_openai_api_key

# Anthropic API Key for response generation (optional - can use OpenAI instead)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Monitoring Configuration
BRAND_NAME=TaxDrop
BRAND_DOMAIN=taxdrop.com
MONITOR_INTERVAL_MINUTES=15

# Subreddits to monitor (comma-separated)
SUBREDDITS=tax,taxes,personalfinance,smallbusiness,Entrepreneur,freelance,selfemployed,accounting,taxpros,IRS

# Keywords to search for (comma-separated)
KEYWORDS=taxdrop,tax drop,taxdrop.com,tax software,tax filing,tax preparation
